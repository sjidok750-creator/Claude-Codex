# 허브 설정 (복사해서 .env 로 저장하거나, 환경변수로 직접 지정)
# 포트/바인딩
PORT=8787
HOST=0.0.0.0
# 데이터 폴더 (SQLite, 시스템 프롬프트 파일, 기본 워크스페이스)
DATA_DIR=./data
# 접근 토큰. Tailscale 안에서만 쓰더라도 설정을 권장. 브라우저에서 http://host:8787/?token=... 로 한 번 열면 쿠키로 저장됨
HUB_TOKEN=
# CLI 실행 파일 (PATH 에 있으면 그대로)
CLAUDE_BIN=claude
CODEX_BIN=codex
# 1 이면 실제 CLI 대신 가짜 에이전트 (UI 확인용)
MOCK_AGENTS=0
# 유휴 Claude 프로세스 종료(ms), 승인 자동 거부(ms), 무응답 턴 중단(ms)
CLAUDE_IDLE_MS=600000
APPROVAL_TIMEOUT_MS=300000
TURN_STALL_MS=600000
